--- a/pkgs/build-support/rust/build-rust-crate/default.nix
+++ b/pkgs/build-support/rust/build-rust-crate/default.nix
@@ -129,6 +129,26 @@
   # stabilized we can account for that here, too, so we don't opt into
   # instability unnecessarily.
   needUnstableCLI = dependencies: lib.any (dep: dep.stdlib or false) dependencies;
+
+  # Order-preserving deduplication of derivations, keyed by outPath.
+  #
+  # Equivalent to `lib.unique` for derivations, because Nix compares two
+  # derivations with `==` by their outPath, and `genericClosure` keeps the
+  # first occurrence of each key in start-set order. `lib.unique` is a
+  # quadratic foldl'/elem scan; completeDeps and completeBuildDeps are
+  # transitive closures recomputed for every crate, so large crate2nix graphs
+  # spend a large part of their evaluation time in it.
+  uniqueDrvs =
+    list:
+    map (entry: entry.drv) (
+      builtins.genericClosure {
+        startSet = map (drv: {
+          key = builtins.unsafeDiscardStringContext (toString drv.outPath);
+          inherit drv;
+        }) list;
+        operator = _: [ ];
+      }
+    );
 
   inherit (import ./log.nix { inherit lib; }) noisily echo_colored;
 
@@ -481,8 +501,8 @@
         dependencies = map lib.getLib (dependencies_ ++ lib.optionals buildTests_ devDependencies_);
         buildDependencies = map lib.getLib buildDependencies_;
 
-        completeDeps = lib.unique (dependencies ++ lib.concatMap (dep: dep.completeDeps) dependencies);
-        completeBuildDeps = lib.unique (
+        completeDeps = uniqueDrvs (dependencies ++ lib.concatMap (dep: dep.completeDeps) dependencies);
+        completeBuildDeps = uniqueDrvs (
           buildDependencies
           ++ lib.concatMap (dep: dep.completeBuildDeps ++ dep.completeDeps) buildDependencies
         );
