# The `nixcfg.macApps.cli` surface: which command declarations are rejected,
# what resolution carries forward, and the shim scripts Home Manager links into
# `~/.local/bin`. These are user-visible strings and paths, so they are
# asserted as values rather than as the shape of the functions that produce
# them.
_:
let
  inherit (import ../lib.nix) assertEq assertThrows;

  context = import ./eval-context.nix { };
  inherit (context) macApps;

  fakePackage =
    {
      pname,
      outPath,
      bundleName,
    }:
    {
      inherit pname outPath;
      passthru.macApp = {
        inherit bundleName;
        bundleRelPath = "Applications/${bundleName}";
        installMode = "copy";
      };
    };

  # One application entry as the option type would produce it.
  applicationEntry =
    {
      bundleName,
      outPath ? "/nix/store/fake-zed",
      ...
    }@entry:
    {
      package = fakePackage {
        pname = "zed-editor-nightly";
        inherit outPath bundleName;
      };
      inherit bundleName;
      mode = "copy";
      preventDowngrade = false;
      scope = "user";
    }
    // builtins.removeAttrs entry [ "outPath" ];

  cliEntry = path: env: { inherit path env; };

  # `cliConfigError` receives the resolved entries and returns the first
  # authoring mistake, or null.
  errorFor =
    cli:
    macApps.cliConfigError [
      {
        targetPath = "/Applications/Example.app";
        inherit cli;
      }
    ];

  shimFor = entries: macApps.cliShimFiles { inherit entries; };

  shimText =
    {
      command,
      targetPath,
      exports ? [ ],
    }:
    builtins.concatStringsSep "\n" (
      [
        "#!/bin/sh"
        "# Generated by nixcfg.macApps for a command-line executable bundled"
        "# inside a managed macOS application."
      ]
      ++ exports
      ++ [
        "app=\"${targetPath}\""
        "if [ ! -x \"$app\" ]; then"
        "  echo \"${command}: $app is missing; apply the nixcfg configuration first\" >&2"
        "  exit 127"
        "fi"
        "exec \"$app\" \"$@\""
      ]
    )
    + "\n";

  resolved = macApps.resolveApplications {
    homeDirectory = "/Users/example";
    applications = {
      zed = (applicationEntry { bundleName = "Zed Nightly.app"; }) // {
        cli = {
          zed = cliEntry "Contents/MacOS/cli" { };
        };
      };
    };
  };

  shims = shimFor [
    {
      targetPath = "/Applications/Zed Nightly.app";
      cli.zed = cliEntry "Contents/MacOS/cli" { };
    }
    {
      targetPath = "/Applications/Tailscale.app";
      cli.tailscale = cliEntry "Contents/MacOS/Tailscale" {
        TAILSCALE_BE_CLI = "1";
      };
    }
  ];

  checks = [
    (assertEq "a command name that is not a plain file name is rejected"
      "nixcfg.macApps cli command names must be plain file names: ../escape"
      (errorFor {
        "../escape" = cliEntry "Contents/MacOS/example" { };
      })
    )
    (assertEq "duplicate command names across applications are rejected"
      "nixcfg.macApps cli command names must be unique across applications: zed"
      (
        macApps.cliConfigError [
          {
            targetPath = "/Applications/One.app";
            cli.zed = cliEntry "Contents/MacOS/one" { };
          }
          {
            targetPath = "/Applications/Two.app";
            cli.zed = cliEntry "Contents/MacOS/two" { };
          }
        ]
      )
    )
    (assertEq "an absolute command path is rejected"
      "nixcfg.macApps cli paths must be bundle-relative: /Applications/Zed.app/Contents/MacOS/cli"
      (errorFor {
        zed = cliEntry "/Applications/Zed.app/Contents/MacOS/cli" { };
      })
    )
    (assertEq "a traversing command path is rejected"
      "nixcfg.macApps cli paths must be bundle-relative: Contents/../../../escape"
      (errorFor {
        zed = cliEntry "Contents/../../../escape" { };
      })
    )
    (assertEq "an environment name that is not a shell identifier is rejected"
      "nixcfg.macApps cli env names must be shell identifiers: BAD NAME"
      (errorFor {
        zed = cliEntry "Contents/MacOS/example" { "BAD NAME" = "1"; };
      })
    )
    (assertEq "distinct command names are accepted" null (
      macApps.cliConfigError [
        {
          targetPath = "/Applications/One.app";
          cli.code-insiders = cliEntry "Contents/MacOS/one" { };
        }
        {
          targetPath = "/Applications/Two.app";
          cli.zed = cliEntry "Contents/MacOS/two" { };
        }
      ]
    ))
    (assertThrows "an invalid command name refuses to render a shim" (shimFor [
      {
        targetPath = "/Applications/Zed Nightly.app";
        cli."../escape" = cliEntry "Contents/MacOS/cli" { };
      }
    ]))

    # Resolution must keep `cli` so shims follow the authoritative copy.
    (assertEq "resolution carries cli metadata" {
      zed = cliEntry "Contents/MacOS/cli" { };
    } resolved.zed.cli)
    (assertEq "resolution computes the user-scoped target path"
      "/Users/example/Applications/Zed Nightly.app"
      resolved.zed.targetPath
    )

    # One shim per command, executable, pointing at the resolved bundle.
    (assertEq "each declared command gets one executable shim" {
      ".local/bin/zed" = {
        source = shimText {
          command = "zed";
          targetPath = "/Applications/Zed Nightly.app/Contents/MacOS/cli";
        };
        executable = true;
      };
      ".local/bin/tailscale" = {
        source = shimText {
          command = "tailscale";
          targetPath = "/Applications/Tailscale.app/Contents/MacOS/Tailscale";
          exports = [ "export TAILSCALE_BE_CLI=\"1\"" ];
        };
        executable = true;
      };
    } shims)
  ];
in
builtins.deepSeq checks true
