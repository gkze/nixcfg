# vi: ft=yaml
---
line_ending: lf
exclude:
  - .claude/worktrees/**
  - .direnv/**
  - .pre-commit-config.yaml
  - .venv/**
  # Vendored upstream bytes, verified against lib/nix/schemas/_version.json.
  - lib/nix/schemas
  - node_modules/**
  - result*/**
formatter:
  type: basic
  indent: 2
  include_document_start: true
  max_line_length: 100
  # Reflowing folded scalars joins authored breaks into lines longer than the
  # yamllint `line-length` rule (max 100) allows. Scanning them as literal
  # keeps the authored wrapping, so the formatter and the linter agree.
  scan_folded_as_literal: true
  trim_trailing_whitespace: true
  eof_newline: true
