+def test_worker_debug_stderr_survives_capture(
+    monkeypatch: pytest.MonkeyPatch, capfd: pytest.CaptureFixture[str]
+) -> None:
+    callbacks: list[Callable[[], None]] = []
+    with monkeypatch.context() as patcher:
+        patcher.setattr(atexit, "register", callbacks.append)
+        stream = worker_debug_stderr()
+    assert len(callbacks) == 1
+    capture = io.StringIO()
+    capture.close()
+    with stream, tempfile.TemporaryFile() as redirected:
+        saved_stderr = os.dup(2)
+        try:
+            with monkeypatch.context() as patcher:
+                patcher.setattr(sys, "stderr", capture)
+                os.dup2(redirected.fileno(), 2)
+                Producer("worker", file=stream)("received command", "shutdown")
+        finally:
+            os.dup2(saved_stderr, 2)
+            os.close(saved_stderr)
+        assert capfd.readouterr().err == "[worker] received command shutdown\n"
+        redirected.seek(0)
+        assert redirected.read() == b""
+        assert not stream.closed
+        callbacks[0]()
+        assert stream.closed
 
 
