+private actor StartSystemRunner: CLIRunning {
+    enum Scenario {
+        case missingConfigThenSuccess
+        case unrelatedFailure
+    }
+
+    private(set) var arguments: [[String]] = []
+    private let scenario: Scenario
+
+    init(scenario: Scenario) {
+        self.scenario = scenario
+    }
+
+    func run(_ request: CLIExecutionRequest) async -> CLIExecutionResult {
+        arguments.append(request.arguments)
+        if scenario == .missingConfigThenSuccess {
+            if arguments.count == 1 {
+                return CLIExecutionResult(
+                    status: 1,
+                    standardOutput: "",
+                    standardError:
+                        "no gateway config at /tmp/gateway.yaml. Fix: run 'baseten-switch config init'",
+                    timedOut: false)
+            }
+            return CLIExecutionResult(
+                status: 0,
+                standardOutput: "",
+                standardError: "",
+                timedOut: false)
+        }
+        return CLIExecutionResult(
+            status: 1,
+            standardOutput: "",
+            standardError: "router port is already owned by another process",
+            timedOut: false)
+    }
+}
