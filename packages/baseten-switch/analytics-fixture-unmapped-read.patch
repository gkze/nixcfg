+    private func fixtureBytes(_ url: URL) throws -> Data {
+        let fd = url.withUnsafeFileSystemRepresentation { representation in
+            guard let representation else { return Int32(-1) }
+            return Darwin.open(representation, O_RDONLY)
+        }
+        guard fd >= 0 else {
+            throw CocoaError(
+                .fileReadNoSuchFile,
+                userInfo: [NSFilePathErrorKey: url.path])
+        }
+        defer { _ = Darwin.close(fd) }
+        var info = Darwin.stat()
+        guard Darwin.fstat(fd, &info) == 0, info.st_size >= 0 else {
+            throw CocoaError(.fileReadUnknown)
+        }
+        let count = Int(info.st_size)
+        var bytes = Data(count: count)
+        var filled = 0
+        while filled < count {
+            let readCount = bytes.withUnsafeMutableBytes { buffer in
+                guard let base = buffer.baseAddress else { return -1 }
+                return Darwin.read(fd, base + filled, count - filled)
+            }
+            if readCount > 0 {
+                filled += readCount
+                continue
+            }
+            if readCount == 0 {
+                break
+            }
+            if errno == EINTR {
+                continue
+            }
+            throw CocoaError(.fileReadUnknown)
+        }
+        guard filled == count else {
+            throw CocoaError(.fileReadCorruptFile)
+        }
+        return bytes
+    }
