+/// Drains one pipe with blocking reads and is the only owner of its
+/// descriptor, which it closes after EOF.
+///
+/// `readabilityHandler = nil` cancels FileHandle's dispatch read source
+/// asynchronously. Closing or releasing the handle right after it leaves
+/// libdispatch watching a closed descriptor; once the next open() reuses
+/// the number, libdispatch traps on a workqueue thread (SIGTRAP). Reading
+/// without a dispatch source, and closing only from the reader, removes
+/// that window. A timed-out caller stops waiting but does not close the
+/// pipe, so a lingering grandchild that still holds the write end only
+/// keeps this reader alive until it exits.
+private final class PipeDrain: @unchecked Sendable {
+    private let buffer: BoundedProcessBuffer
+    private let finished = DispatchGroup()
+
+    init(_ handle: FileHandle, limit: Int) {
+        let buffer = BoundedProcessBuffer(limit: limit)
+        self.buffer = buffer
+        finished.enter()
+        DispatchQueue.global(qos: .utility).async { [finished] in
+            while let data = try? handle.read(upToCount: 64 * 1024),
+                  !data.isEmpty {
+                buffer.append(data)
+            }
+            try? handle.close()
+            finished.leave()
+        }
+    }
+
+    func waitForEOF() async {
+        await withCheckedContinuation { continuation in
+            finished.notify(queue: .global(qos: .utility)) {
+                continuation.resume()
+            }
+        }
+    }
+
+    func string() -> String {
+        buffer.string()
+    }
+}
