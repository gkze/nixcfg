+    func testSystemRunnerCapturesOutputAfterNormalExit() async {
+        let result = await SystemCLIRunner().run(CLIExecutionRequest(
+            binary: URL(fileURLWithPath: "/bin/sh"),
+            arguments: ["-c", "printf out; printf err >&2; exit 3"],
+            environment: ["PATH": "/usr/bin:/bin"],
+            timeout: 5))
+
+        XCTAssertFalse(result.timedOut)
+        XCTAssertEqual(result.status, 3)
+        XCTAssertEqual(result.standardOutput, "out")
+        XCTAssertEqual(result.standardError, "err")
+    }
+
+    // A pipe descriptor closed while a dispatch read source still watches it
+    // is reused by the next open(); libdispatch then traps on a workqueue
+    // thread and takes down whichever test runs next.
+    func testSystemRunnerTimeoutLeavesNoWatchedDescriptorForReuse() async throws {
+        let result = await SystemCLIRunner().run(CLIExecutionRequest(
+            binary: URL(fileURLWithPath: "/bin/sh"),
+            arguments: ["-c", "sleep 2"],
+            environment: ["PATH": "/usr/bin:/bin"],
+            timeout: 0.1))
+        XCTAssertTrue(result.timedOut)
+
+        for _ in 0..<256 {
+            let handle = try XCTUnwrap(FileHandle(forReadingAtPath: "/dev/null"))
+            try handle.close()
+        }
+        try await Task.sleep(nanoseconds: 300_000_000)
+    }
