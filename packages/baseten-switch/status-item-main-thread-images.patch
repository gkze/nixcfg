+/// Load and rasterize a template image on the main thread.
+///
+/// `NSImage(contentsOf:)` returns before AppKit reads the file. That read
+/// then runs on a GCD workqueue (`_pthread_wqthread`) and SIGTRAPs at the
+/// same shared-cache instruction as `Data(contentsOf:)` (page offset
+/// 0x077c). Update 42071786632 hit it after the status-item menu rebuild,
+/// once XCTest had already started the next RuntimeCoordination test.
+/// Reading the bytes here and drawing them before return keeps both on
+/// the main thread.
+func mainThreadTemplateImage(contentsOf url: URL, size: NSSize? = nil) -> NSImage? {
+    onMainThread {
+        guard let data = try? Data(contentsOf: url),
+              let source = NSImage(data: data) else { return nil }
+        source.isTemplate = true
+        if let size {
+            source.size = size
+        }
+        return mainThreadRasterizedImage(source)
+    }
+}
+
+/// Draw `source` before returning so a drawing handler or a still-lazy
+/// representation cannot run later on a workqueue.
+func mainThreadRasterizedImage(_ source: NSImage) -> NSImage {
+    onMainThread {
+        let canvas = source.size.width > 0 && source.size.height > 0
+            ? source.size
+            : NSSize(width: 16, height: 16)
+        let image = NSImage(size: canvas)
+        image.lockFocus()
+        source.draw(in: NSRect(origin: .zero, size: canvas))
+        image.unlockFocus()
+        image.isTemplate = source.isTemplate
+        image.size = canvas
+        return image
+    }
+}
+
+func onMainThread<T>(_ body: () -> T) -> T {
+    if Thread.isMainThread {
+        return body()
+    }
+    return DispatchQueue.main.sync(execute: body)
+}
