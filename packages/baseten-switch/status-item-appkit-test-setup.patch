 final class RuntimeCoordinationTests: XCTestCase {
+
+    // StatusItemController asks NSStatusBar for an item, which aborts in
+    // SkyLight unless AppKit's window-server connection exists. The app gets
+    // it from NSApplication at launch; a bare XCTest process does not.
+    // This hook is not @MainActor. swift test runs it on the XCTest worker
+    // (the analytics-fixture SIGTRAP was Thread 3) and parks the main thread
+    // on the run loop so the @MainActor status test can run. sharedApplication
+    // has to be created there. Creating it on the worker is what made that
+    // worker's later Data(contentsOf:) SIGTRAP (Updates 41616086680 and
+    // 41733265858).
+    override class func setUp() {
+        super.setUp()
+        let openAppKit = {
+            MainActor.assumeIsolated {
+                _ = NSApplication.shared
+            }
+        }
+        if Thread.isMainThread {
+            openAppKit()
+        } else {
+            DispatchQueue.main.sync(execute: openAppKit)
+        }
+    }
+
     private let previewConfigPath =
         "/tmp/baseten-switch-home/.config/baseten-switch-preview/gateway.yaml"
 
